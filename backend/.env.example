PORT=5001
NODE_ENV=development

# Neon Serverless PostgreSQL Connection String (Found in Neon Console -> Connection String)
DATABASE_URL=postgresql://[USER]:[PASSWORD]@[ENDPOINT].aws.neon.tech/neondb?sslmode=require

# Cloudinary Configuration (Found in Cloudinary Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Firebase Project Configuration
FIREBASE_PROJECT_ID=rentu-732b7

# Fallback JWT Secret
JWT_SECRET=super-secret-borrowflex-key-2026-v1

# Rentu AI Assistant Configuration (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
