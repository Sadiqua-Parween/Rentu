PORT=5001
NODE_ENV=development

# Supabase PostgreSQL Connection String (Found in Supabase Project Settings -> Database -> Connection URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Storage & API Keys (Found in Supabase Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Firebase Project Configuration
FIREBASE_PROJECT_ID=rentu-732b7

# Fallback JWT Secret (Must be changed in production)
JWT_SECRET=your-random-32-character-secret-key-here

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Web Push VAPID Keys (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=[YOUR-VAPID-PUBLIC-KEY]
VAPID_PRIVATE_KEY=[YOUR-VAPID-PRIVATE-KEY]
VAPID_SUBJECT=mailto:support@rentu.app

# Rentu AI Assistant Configuration
# Recommended: Free Google Gemini API Key from https://aistudio.google.com/
# Alternatively: OpenAI API Key from https://platform.openai.com/
AI_API_KEY=[YOUR-AI-API-KEY]
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash



